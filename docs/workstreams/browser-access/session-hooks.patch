@@ -0,0 +1,164 @@
+import { describe, expect, it } from 'vitest';
+import type { BrowserRequest } from './types';
+import { Harness, REST } from './session.test-support';
+
+function ready() {
+  const h = new Harness();
+  h.setUpToCommunication();
+  const requests: BrowserRequest[] = [];
+  h.session.setBrowserSink((request) => requests.push(request));
+  return { h, requests };
+}
+const ids = (h: Harness) => h.snap.scan?.targets.map((target) => target.id);
+
+describe('browser companion hooks', () => {
+  it('adds nothing to communication until a controller is attached', () => {
+    const h = new Harness();
+    h.setUpToCommunication();
+    expect(ids(h)).not.toContain('browse');
+    expect(h.snap.scope).toBe('communication');
+    expect(h.snap.browserAvailable).toBe(false);
+  });
+
+  it('offers Browse, binds only through the controller, and builds the five-tile list without speed controls', () => {
+    const { h, requests } = ready();
+    expect(ids(h)).toContain('browse');
+    h.selectByGesture('browse');
+    expect(requests).toEqual(['browse']);
+    expect(h.snap.scope).toBe('communication');
+    expect(h.session.enterBrowserScope()).toBe(true);
+    expect(ids(h)).toEqual(['browser:scroll-down', 'browser:scroll-up', 'browser:back', 'pause', 'browser:return']);
+    expect(h.snap.scan?.targets.some((target) => target.id === 'slower' || target.id === 'faster')).toBe(false);
+  });
+
+  it('one hold is one request, and Return and Pause are reachable with a select-only mapping', () => {
+    const { h, requests } = ready();
+    expect(h.session.enterBrowserScope()).toBe(true);
+    h.selectByGesture('browser:scroll-down', undefined, 60_000, 4_000);
+    expect(requests).toEqual(['scroll-down']);
+    const before = h.session.getInputEpoch();
+    h.selectByGesture('pause');
+    expect(h.snap.scan?.paused).toBe(true);
+    expect(h.snap.scope).toBe('browser');
+    expect(h.session.getInputEpoch()).toBeGreaterThan(before);
+    h.selectByGesture('pause'); // the same movement resumes after neutral
+    expect(h.snap.scan?.paused).toBe(false);
+    h.selectByGesture('browser:return');
+    expect(h.snap.scope).toBe('communication');
+    expect(ids(h)).toContain('phrase:0');
+    expect(requests).toEqual(['scroll-down']);
+  });
+
+  it('every non-tracked frame, hidden change and rebuild changes the epoch and calls listeners', () => {
+    const { h } = ready();
+    let calls = 0;
+    h.session.onFailClosed(() => { calls += 1; });
+    for (const tracking of ['invalid', 'stale', 'missing', 'multiple'] as const) {
+      const epoch = h.session.getInputEpoch();
+      h.step(REST, tracking);
+      expect(h.session.getInputEpoch()).toBeGreaterThan(epoch);
+    }
+    const hidden = h.session.getInputEpoch();
+    h.session.setHidden(true, h.now);
+    expect(h.session.getInputEpoch()).toBeGreaterThan(hidden);
+    expect(calls).toBeGreaterThan(3);
+  });
+
+  it('detaching the controller while browsing returns to communication; listener errors are contained', () => {
+    const { h } = ready();
+    h.session.onFailClosed(() => { throw new Error('consumer bug'); });
+    expect(h.session.enterBrowserScope()).toBe(true);
+    h.session.setBrowserSink(null);
+    expect(h.snap.scope).toBe('communication');
+    expect(ids(h)).not.toContain('browse');
+  });
+
+  it('refuses browser scope when hidden, paused, or outside communication', () => {
+    const { h } = ready();
+    h.session.setHidden(true, h.now);
+    expect(h.session.enterBrowserScope()).toBe(false);
+    expect(h.session.returnToCommunication()).toBe(true);
+  });
+
+  it('works with the assisted driver: Pause and Return are reachable and each press is one request', () => {
+    const h = new Harness();
+    h.session.useAssisted();
+    const requests: BrowserRequest[] = [];
+    h.session.setBrowserSink((request) => requests.push(request));
+    expect(h.session.enterBrowserScope()).toBe(true);
+    const reach = (id: string) => {
+      for (let guard = 0; h.highlightedId() !== id; guard += 1) { if (guard > 400) throw new Error(`never highlighted ${id}`); h.step(REST); }
+      h.session.switchPress(h.now);
+    };
+    reach('browser:scroll-up');
+    expect(requests).toEqual(['scroll-up']);
+    reach('pause');
+    expect(h.snap.scan?.paused).toBe(true);
+    expect(h.snap.scope).toBe('browser');
+    h.session.switchPress(h.now); // resume
+    expect(h.snap.scan?.paused).toBe(false);
+    reach('browser:return');
+    expect(h.snap.scope).toBe('communication');
+    expect(requests).toEqual(['scroll-up']);
+  });
+
+  describe.each(['gesture', 'assisted'] as const)('Pause survives scope changes (%s driver)', (driver) => {
+    function pausedInBrowser() {
+      const h = new Harness();
+      if (driver === 'gesture') h.setUpToCommunication(); else h.session.useAssisted();
+      const requests: BrowserRequest[] = [];
+      const sink = (request: BrowserRequest) => { requests.push(request); };
+      h.session.setBrowserSink(sink);
+      expect(h.session.enterBrowserScope()).toBe(true);
+      const reach = (id: string) => {
+        if (driver === 'gesture') { h.selectByGesture(id); return; }
+        for (let guard = 0; h.highlightedId() !== id; guard += 1) { if (guard > 400) throw new Error(`never highlighted ${id}`); h.step(REST); }
+        h.session.switchPress(h.now);
+      };
+      reach('pause');
+      expect(h.snap.scan?.paused).toBe(true);
+      return { h, sink, requests };
+    }
+
+    it('pause then Return', () => {
+      const { h } = pausedInBrowser();
+      expect(h.session.returnToCommunication()).toBe(true);
+      expect(h.snap.scope).toBe('communication');
+      expect(h.snap.scan?.paused).toBe(true);
+    });
+
+    it('pause then tracking loss and automatic return', () => {
+      const { h } = pausedInBrowser();
+      h.step(REST, 'invalid');
+      expect(h.session.returnToCommunication()).toBe(true);
+      expect(h.snap.scan?.paused).toBe(true);
+    });
+
+    it('pause then attach and detach', () => {
+      const { h, sink } = pausedInBrowser();
+      h.session.setBrowserSink(sink); // same identity: no-op, no rebuild
+      expect(h.snap.scan?.paused).toBe(true);
+      expect(h.snap.scope).toBe('browser');
+      h.session.setBrowserSink(() => {});
+      expect(h.snap.scan?.paused).toBe(true);
+      h.session.setBrowserSink(null);
+      expect(h.snap.scope).toBe('communication');
+      expect(h.snap.scan?.paused).toBe(true);
+    });
+
+    it('pause then idle return keeps Pause', () => {
+      const { h } = pausedInBrowser();
+      h.stall(200_000);
+      expect(h.session.returnToCommunication()).toBe(true);
+      expect(h.snap.scan?.paused).toBe(true);
+    });
+
+    it('an unchanged sink is a no-op that does not rebuild the scanner or change the epoch', () => {
+      const { h, sink } = pausedInBrowser();
+      const epoch = h.session.getInputEpoch();
+      h.session.setBrowserSink(sink);
+      expect(h.session.getInputEpoch()).toBe(epoch);
+    });
+  });
+});
+
